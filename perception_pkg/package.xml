<?xml version="1.0"?>
<package format="3">
  <name>sensor_fusion_cpm</name>
  <version>0.0.1</version>
  <description>Perception fusion node using depth + object detections + RViz visualization.</description>

  <maintainer email="your_email@example.com">your_name</maintainer>
  <license>MIT</license>

  <!-- Build tools -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies used by the node -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>vx_custom_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
   
  </export>
</package>